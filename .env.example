# Copy file này thành .env và điền thông tin thực tế

# Verify Token cho webhook (bạn tự tạo, ví dụ: "my_verify_token_123")
VERIFY_TOKEN=your_verify_token_here

# Page Access Token từ Facebook Developers Console
PAGE_ACCESS_TOKEN=your_page_access_token_here

# Port cho server (Replit sẽ tự động set)
PORT=3000